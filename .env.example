# Copy to .env.local (git-ignored) to configure where publish-trip-explorer.sh deploys.

# Cloudflare Pages project name (default: travel)
TRAVEL_DEPLOY_PROJECT=my-trips

# Optional: public URL printed after deploy
TRAVEL_DEPLOY_URL=https://my-trips.pages.dev

# Optional: your own deploy script, called as: <cmd> <project> <dir>.
# Leave unset to use: npx wrangler pages deploy <dir> --project-name <project>
# TRAVEL_DEPLOY_CMD=$HOME/bin/deploy-pages.sh
